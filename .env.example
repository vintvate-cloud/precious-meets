# Precious Meets - Environment Configuration
# Copy this file to .env.local or set variables in your deployment dashboard

# -------------------------------------------------------------
# Supabase Configuration
# -------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-client

# -------------------------------------------------------------
# Site & Domain Configuration
# -------------------------------------------------------------
VITE_SITE_URL=http://localhost:5173
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# -------------------------------------------------------------
# Google OAuth (configured via Supabase Dashboard -> Authentication -> Providers)
# -------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# -------------------------------------------------------------
# Razorpay Payments (Standard Checkout & Server Verification)
# -------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyHere
RAZORPAY_KEY_ID=rzp_test_YourKeyHere
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# -------------------------------------------------------------
# Resend Email Delivery
# -------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Precious Meets <invitations@preciousmeets.com>
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret_here

# -------------------------------------------------------------
# Identity Verification Provider (DigiLocker / Offline Aadhaar Provider)
# Note: In accordance with UIDAI regulations, no raw Aadhaar numbers or biometrics are stored.
# -------------------------------------------------------------
IDENTITY_PROVIDER_BASE_URL=https://api.sandbox.id-provider.in
IDENTITY_PROVIDER_CLIENT_ID=your_provider_client_id
IDENTITY_PROVIDER_CLIENT_SECRET=your_provider_client_secret
IDENTITY_PROVIDER_WEBHOOK_SECRET=your_provider_webhook_secret
IDENTITY_VERIFICATION_MOCK_MODE=true

# -------------------------------------------------------------
# Web Push Notifications (VAPID)
# -------------------------------------------------------------
VITE_PUSH_NOTIFICATION_PUBLIC_KEY=your_vapid_public_key_here
PUSH_NOTIFICATION_PUBLIC_KEY=your_vapid_public_key_here
PUSH_NOTIFICATION_PRIVATE_KEY=your_vapid_private_key_here
PUSH_NOTIFICATION_SUBJECT=mailto:security@preciousmeets.com

# -------------------------------------------------------------
# Admin & Emergency SOS Escalation
# -------------------------------------------------------------
ADMIN_EMAILS=admin@preciousmeets.com,safety@preciousmeets.com
EMERGENCY_ESCALATION_PHONE=+919876543210
